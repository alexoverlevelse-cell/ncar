# Скопировать в .env.local и заполнить реальными значениями из настроек проекта Supabase.
# .env.local в git не попадает (см. .gitignore) — секреты храним только локально/в настройках хостинга.

# Публичные (можно использовать в браузере)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Секретные — ТОЛЬКО для серверного кода. Никогда не добавлять префикс NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Токен Telegram-бота, привязанного к Mini App (для проверки initData на сервере)
TELEGRAM_BOT_TOKEN=

# Telegram ID администраторов через запятую, например: 111111111,222222222
# Админ может редактировать и удалять ЛЮБЫЕ объявления, не только свои.
# Не коммитить реальные значения — репозиторий публичный.
ADMIN_TELEGRAM_IDS=

# Публичный адрес деплоя — нужен вебхуку бота, чтобы собрать ссылку на
# public/bot/open-app-guide.png для sendPhoto.
NEXT_PUBLIC_SITE_URL=

# Секрет для проверки, что запрос на /api/bot/webhook действительно от
# Telegram (см. setWebhook secret_token). Сгенерировать случайной строкой.
TELEGRAM_WEBHOOK_SECRET=
